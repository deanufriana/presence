generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GitLabCommit {
  id             String   @id
  shortId        String
  title          String
  message        String?
  authorName     String
  authorEmail    String
  authoredDate   DateTime
  committerName  String
  committerEmail String
  committedDate  DateTime
  webUrl         String
  projectName    String
  projectPath    String
  projectId      Int
  branchName     String?
  branchNames    String?
  actionName     String?
  createdAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([authorEmail])
  @@index([createdAt])
}

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  date      String
  summary   String
  startTime String?
  endTime   String?
  updatedAt DateTime @updatedAt

  @@index([date])
}

model DailyReport {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  masuk     String?
  pulang    String?
  ti        String?
  aktivitas String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyReport {
  id        Int      @id @default(autoincrement())
  month    String
  project   String?
  progres   String?
  done      String?
  status    String?
  sources   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

model SummaryLog {
  id        Int      @id @default(autoincrement())
  period    String   @unique
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period])
}

model JiraActivity {
  id          String   @id
  key         String
  summary     String
  type        String
  status      String?
  projectName String?
  updatedAt   DateTime
  userEmail   String
  webUrl      String?

  @@index([userEmail])
  @@index([updatedAt])
}

model YearlyReport {
  id          Int      @id @default(autoincrement())
  year        String
  tanggal     String?
  month      String?
  task        String?
  deliverable String?
  status      String?
  keterangan  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
}

model Holiday {
  id         Int      @id @default(autoincrement())
  date       String
  name       String
  is_holiday Boolean
  type       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date, name])
  @@index([date])
}

